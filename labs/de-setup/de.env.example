# functionspace — describe YOUR VAST cluster once; every DataEngine lab reads this.
#
# Copy it next to your lab folders and fill it in:
#   cp de.env.example ../de.env && $EDITOR ../de.env
#
# Every value below is a placeholder. Find the real ones with the commands in
# the lab 06 guide (vastde compute-clusters list, container-registries list,
# topics list, buckets list) or ask your VAST administrator. Never commit the
# filled-in file: it names your environment.

# Your handle: the same PREFIX you saved on the course site. Every object the
# labs create is named from it, so several people can share one tenant.
PREFIX=alice

# VAST Management Service URL and the tenant that has DataEngine enabled.
VMS_URL=https://vms.example.internal
TENANT=my-tenant

# The Kubernetes compute cluster linked to the tenant (vastde compute-clusters list)
# and the namespace pipelines deploy into.
K8S_CLUSTER=my-compute-cluster
NAMESPACE=my-pipelines-namespace

# The container registry linked to the tenant: its DataEngine resource name
# (vastde container-registries list) and the host:port you docker push to.
# Host and port only: container-registries get prints https://host:port, and
# docker tag rejects an image name that starts with a scheme.
REGISTRY=my-registry
REGISTRY_URL=registry.example.internal:5000

# The event broker and topic pipelines link triggers through (vastde topics list).
BROKER=my-broker
TOPIC=my-topic

# An S3-enabled bucket you may write to (vastde buckets list), and its S3 endpoint.
# S3 credentials come from your usual AWS environment/profile, not this file.
BUCKET=my-bucket
S3_ENDPOINT=https://s3.example.internal

# The DataEngine builder image matching your CLI version.
BUILDER_IMAGE=vastdataorg/vast-builder:v5.5.0-sp2

# Only if ./vastde-docker.sh status says your Docker cannot run vastde
# (Docker Engine 29+): run ./vastde-docker.sh start and uncomment this line.
# Every shell or lab script that sources de.env then uses the Docker 28
# daemon; nothing else does.
# export DOCKER_HOST=tcp://127.0.0.1:23750
